# Backend URL used only by the Vite development server.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public API base. Keep relative locally; set the HTTPS value on Vercel Production.
# VITE_API_BASE=https://api-ws.mindsept.fr/api/v1
VITE_API_BASE=/api/v1
# Match the backend MAX_FILE_BYTES setting. Default: 20 MiB.
VITE_MAX_UPLOAD_MB=20

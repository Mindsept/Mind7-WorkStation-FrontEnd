# Backend URL used only by the Vite development server.
API_PROXY_TARGET=http://127.0.0.1:8000
# Mocks work only in Vite development mode. Never an automatic fallback.
VITE_MOCK_API=false
# Match backend MAX_FILE_BYTES. Default: 20 MiB.
VITE_MAX_UPLOAD_MB=20

# Optional explicit local backend development identity links. Ignored in production.
VITE_SHOW_DEV_SIGNIN=false
